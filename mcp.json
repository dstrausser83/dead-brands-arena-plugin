{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dead-brands-arena": {
      "type": "stdio",
      "command": "node",
      "args": [
        "server/proxy.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "DEAD_BRANDS_ARENA_KEY": "${DEAD_BRANDS_ARENA_KEY}",
        "DEAD_BRANDS_ARENA_URL": "${DEAD_BRANDS_ARENA_URL}"
      }
    }
  }
}
